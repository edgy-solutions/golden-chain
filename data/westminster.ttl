# Westminster Confession of Faith (docs/sources/westminster.md). Reference only; no quotation.
# Arguments cite the proof texts attached to the clause that states the Position.

<body/wcf> a gc:Confession ;
    rdfs:label "Westminster Confession of Faith (1647)"@en ;
    gc:expressedIn <source/wcf> .

<source/wcf> a gc:SourceWork ;
    rdfs:label "Westminster Confession of Faith (1647), with proof texts"@en ;
    dcterms:bibliographicCitation "Witness: Edinburgh: Evan Tyler, 1647 (ruling on report 5 Q7; edition stated once, ruling on report 8 Q4)." .

<source/wcf/7/3> a gc:SourceDivision ;
    rdfs:label "WCF 7.3"@en ;
    dcterms:isPartOf <source/wcf> .

