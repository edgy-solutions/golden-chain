@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# Westminster Confession of Faith (docs/sources/westminster.md). Reference only; no quotation.
# Arguments cite the proof texts attached to the clause that states the Position.

<body/wcf> a gc:Confession ;
    rdfs:label "Westminster Confession of Faith (1647)"@en ;
    gc:expressedIn <source/wcf> .

<source/wcf> a gc:SourceWork ;
    rdfs:label "Westminster Confession of Faith (1647), with proof texts"@en .

<source/wcf/7/5> a gc:SourceDivision ;
    rdfs:label "WCF 7.5"@en ;
    dcterms:isPartOf <source/wcf> .

<source/wcf/7/6> a gc:SourceDivision ;
    rdfs:label "WCF 7.6"@en ;
    dcterms:isPartOf <source/wcf> .

<source/wcf/27/1> a gc:SourceDivision ;
    rdfs:label "WCF 27.1"@en ;
    dcterms:isPartOf <source/wcf> .

<source/wcf/28/1> a gc:SourceDivision ;
    rdfs:label "WCF 28.1"@en ;
    dcterms:isPartOf <source/wcf> .

<source/wcf/28/2> a gc:SourceDivision ;
    rdfs:label "WCF 28.2"@en ;
    dcterms:isPartOf <source/wcf> .

<source/wcf/28/3> a gc:SourceDivision ;
    rdfs:label "WCF 28.3"@en ;
    dcterms:isPartOf <source/wcf> .

<source/wcf/28/4> a gc:SourceDivision ;
    rdfs:label "WCF 28.4"@en ;
    dcterms:isPartOf <source/wcf> .

<source/wcf/28/6> a gc:SourceDivision ;
    rdfs:label "WCF 28.6"@en ;
    dcterms:isPartOf <source/wcf> .

# ---------------------------------------------------------------- holdings

<body/wcf> gc:holds <holding/wcf/covenant-administrations/one-covenant-two-administrations> .

<holding/wcf/covenant-administrations/one-covenant-two-administrations> a gc:Holding ;
    gc:position <position/covenant-administrations/one-covenant-two-administrations> ;
    gc:modality <vocab/modality/taught> ;
    dcterms:source <source/wcf/7/5> , <source/wcf/7/6> ;
    gc:status <vocab/status/proposed> ;
    gc:proposedBy <agent/build-agent> .

<body/wcf> gc:holds <holding/wcf/baptism-perpetuity/standing-ordinance-to-the-end> .

<holding/wcf/baptism-perpetuity/standing-ordinance-to-the-end> a gc:Holding ;
    gc:position <position/baptism-perpetuity/standing-ordinance-to-the-end> ;
    gc:modality <vocab/modality/taught> ;
    dcterms:source <source/wcf/28/1> ;
    gc:status <vocab/status/proposed> ;
    gc:proposedBy <agent/build-agent> .

# Ruling 4, 28.4: the canonical WALL.
<body/wcf> gc:holds <holding/wcf/baptism-subjects/believers-and-their-infants> .

<holding/wcf/baptism-subjects/believers-and-their-infants> a gc:Holding ;
    gc:position <position/baptism-subjects/believers-and-their-infants> ;
    gc:modality <vocab/modality/required> ;
    dcterms:source <source/wcf/28/4> ;
    gc:status <vocab/status/ratified> ;
    gc:proposedBy <agent/build-agent> ;
    gc:ratifiedBy <agent/architect> ;
    dcterms:dateAccepted "2026-10-25"^^xsd:date .

<body/wcf> gc:holds <holding/wcf/baptism-subjects/professing-believers-only> .

<holding/wcf/baptism-subjects/professing-believers-only> a gc:Holding ;
    gc:position <position/baptism-subjects/professing-believers-only> ;
    gc:modality <vocab/modality/forbidden> ;
    dcterms:source <source/wcf/28/4> ;
    gc:derivedBy "implication" ;
    gc:status <vocab/status/ratified> ;
    gc:proposedBy <agent/build-agent> ;
    gc:ratifiedBy <agent/architect> ;
    dcterms:dateAccepted "2026-10-25"^^xsd:date .

# Ruling 4, 28.3: officers only; immersion itself is not forbidden to all.
<body/wcf> gc:holds <holding/wcf/baptism-mode/mode-indifferent/officers> .

<holding/wcf/baptism-mode/mode-indifferent/officers> a gc:Holding ;
    gc:position <position/baptism-mode/mode-indifferent> ;
    gc:modality <vocab/modality/required> ;
    gc:scope <vocab/scope/officers> ;
    dcterms:source <source/wcf/28/3> ;
    gc:status <vocab/status/ratified> ;
    gc:proposedBy <agent/build-agent> ;
    gc:ratifiedBy <agent/architect> ;
    dcterms:dateAccepted "2026-10-25"^^xsd:date .

<body/wcf> gc:holds <holding/wcf/baptism-mode/immersion-only/officers> .

<holding/wcf/baptism-mode/immersion-only/officers> a gc:Holding ;
    gc:position <position/baptism-mode/immersion-only> ;
    gc:modality <vocab/modality/forbidden> ;
    gc:scope <vocab/scope/officers> ;
    dcterms:source <source/wcf/28/3> ;
    gc:derivedBy "implication" ;
    gc:status <vocab/status/ratified> ;
    gc:proposedBy <agent/build-agent> ;
    gc:ratifiedBy <agent/architect> ;
    dcterms:dateAccepted "2026-10-25"^^xsd:date .

<body/wcf> gc:holds <holding/wcf/baptism-formula/triune-name> .

<holding/wcf/baptism-formula/triune-name> a gc:Holding ;
    gc:position <position/baptism-formula/triune-name> ;
    gc:modality <vocab/modality/taught> ;
    dcterms:source <source/wcf/28/2> ;
    gc:status <vocab/status/proposed> ;
    gc:proposedBy <agent/build-agent> .

<body/wcf> gc:holds <holding/wcf/baptism-significance/union-with-christ> .

<holding/wcf/baptism-significance/union-with-christ> a gc:Holding ;
    gc:position <position/baptism-significance/union-with-christ> ;
    gc:modality <vocab/modality/taught> ;
    dcterms:source <source/wcf/28/1> ;
    gc:status <vocab/status/proposed> ;
    gc:proposedBy <agent/build-agent> .

<body/wcf> gc:holds <holding/wcf/baptism-significance/sign-and-seal-of-the-covenant> .

<holding/wcf/baptism-significance/sign-and-seal-of-the-covenant> a gc:Holding ;
    gc:position <position/baptism-significance/sign-and-seal-of-the-covenant> ;
    gc:modality <vocab/modality/taught> ;
    dcterms:source <source/wcf/27/1> , <source/wcf/28/1> ;
    gc:status <vocab/status/proposed> ;
    gc:proposedBy <agent/build-agent> .

<body/wcf> gc:holds <holding/wcf/baptism-efficacy/grace-conferred-in-right-use> .

<holding/wcf/baptism-efficacy/grace-conferred-in-right-use> a gc:Holding ;
    gc:position <position/baptism-efficacy/grace-conferred-in-right-use> ;
    gc:modality <vocab/modality/taught> ;
    dcterms:source <source/wcf/28/6> ;
    gc:status <vocab/status/proposed> ;
    gc:proposedBy <agent/build-agent> .

# Ruling 4, 28.7 (rebaptism forbidden): not minted; no phase-1 locus and no Position mintable under rule 2.
