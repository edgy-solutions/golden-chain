# ---------------------------------------------------------------- arguments

# LBC 7.3, one Argument per note. Note g (salvation of the OT saints) is deliberately not minted:
# note g — salvation of the OT saints — does not separate (ii) from (iii); not cited.

<argument/lbc-1689/7/3/001> a gc:Argument ;
    gc:source <source/lbc-1689/7/3> ;
    gc:supports <position/covenant-of-grace/established-in-new-covenant> ;
    gc:cites <passage/kjv/Gen.3.15> ;
    gc:locator "7.3" ;
    gc:asPrinted "e Gen. 3.15." ;
    rdfs:comment "asPrinted taken from a reading transcription (bible-researcher.com, after CCEL; two reads agree), not from the 1677 facsimile; flagged until Chris reads the 1677 margin letters (ruling M10 on the step-3 plan)."@en ;
    gc:status <vocab/status/proposed> ;
    gc:proposedBy <agent/build-agent> .

<argument/lbc-1689/7/3/002> a gc:Argument ;
    gc:source <source/lbc-1689/7/3> ;
    gc:supports <position/covenant-of-grace/established-in-new-covenant> ;
    gc:cites <passage/kjv/Heb.1.1> ;
    gc:locator "7.3" ;
    gc:asPrinted "f Heb. 1.1." ;
    rdfs:comment "asPrinted taken from a reading transcription (bible-researcher.com, after CCEL; two reads agree), not from the 1677 facsimile; flagged until Chris reads the 1677 margin letters (ruling M10 on the step-3 plan)."@en ;
    gc:status <vocab/status/proposed> ;
    gc:proposedBy <agent/build-agent> .

<argument/lbc-1689/7/3/003> a gc:Argument ;
    gc:source <source/lbc-1689/7/3> ;
    gc:supports <position/covenant-of-grace/established-in-new-covenant> ;
    gc:cites <passage/kjv/2Tim.1.9> ,
        <passage/kjv/Titus.1.2> ;
    gc:locator "7.3" ;
    gc:asPrinted "* 2 Tim. 1.9. Tit. 1.2." ;
    rdfs:comment "asPrinted taken from a reading transcription (bible-researcher.com, after CCEL; two reads agree), not from the 1677 facsimile; flagged until Chris reads the 1677 margin letters (ruling M10 on the step-3 plan)."@en ;
    gc:status <vocab/status/proposed> ;
    gc:proposedBy <agent/build-agent> .

<argument/lbc-1689/28/1/001> a gc:Argument ;
    gc:source <source/lbc-1689/28/1> ;
    gc:supports <position/baptism-perpetuity/standing-ordinance-to-the-end> ;
    gc:cites <passage/kjv/Matt.28.19-Matt.28.20> ,
        <passage/kjv/1Cor.11.26> ;
    gc:locator "28.1" ;
    gc:secondaryLocator "1677 first printing, facsimile edition (2000), p. 96, \"Of Baptism and the Lords Supper\"" ;
    gc:asPrinted "(a) Mat. 28. 19, 20. 1 Cor. 11. 26." ;
    gc:status <vocab/status/proposed> ;
    gc:proposedBy <agent/build-agent> .

<argument/lbc-1689/29/1/001> a gc:Argument ;
    gc:source <source/lbc-1689/29/1> ;
    gc:supports <position/baptism-significance/union-with-christ> ;
    gc:cites <passage/kjv/Rom.6.3-Rom.6.5> ,
        <passage/kjv/Col.2.12> ,
        <passage/kjv/Gal.3.27> ;
    gc:locator "29.1" ;
    gc:secondaryLocator "1677 first printing, facsimile edition (2000), sig. H, \"Of Baptism\"" ;
    gc:asPrinted "(c) Rom. 6.3,4,5; Col. 2.12; Gal. 3.27" ;
    gc:status <vocab/status/proposed> ;
    gc:proposedBy <agent/build-agent> .

<argument/lbc-1689/29/1/002> a gc:Argument ;
    gc:source <source/lbc-1689/29/1> ;
    gc:supports <position/baptism-significance/union-with-christ> ;
    gc:cites <passage/kjv/Mark.1.4> ,
        <passage/kjv/Acts.22.16> ;
    gc:locator "29.1" ;
    gc:secondaryLocator "1677 first printing, facsimile edition (2000), sig. H, \"Of Baptism\"" ;
    gc:asPrinted "(d) Mar. 1.4; Act. 26. 16" ;
    gc:resolutionNote "\"Act. 26. 16\" is in the 1677 printing, not a later slip (confirmed from the page by the architect). Resolved to Acts 22:16 (the remission-of-sins clause), a 22->26 compositor error; resolution proposed by the architect. The earlier candidates Acts 2:41 and 8:12 are withdrawn." ;
    gc:status <vocab/status/proposed> ;
    gc:proposedBy <agent/build-agent> .

<argument/lbc-1689/29/1/003> a gc:Argument ;
    gc:source <source/lbc-1689/29/1> ;
    gc:supports <position/baptism-significance/union-with-christ> ;
    gc:cites <passage/kjv/Rom.6.2> ,
        <passage/kjv/Rom.6.4> ;
    gc:locator "29.1" ;
    gc:secondaryLocator "1677 first printing, facsimile edition (2000), sig. H, \"Of Baptism\"" ;
    gc:asPrinted "(e) Rom. 6.2,4" ;
    gc:status <vocab/status/proposed> ;
    gc:proposedBy <agent/build-agent> .

<argument/lbc-1689/29/2/001> a gc:Argument ;
    gc:source <source/lbc-1689/29/2> ;
    gc:supports <position/baptism-subjects/professing-believers-only> ;
    gc:cites <passage/kjv/Mark.16.16> ,
        <passage/kjv/Acts.8.36-Acts.8.37> ;
    gc:locator "29.2" ;
    gc:secondaryLocator "1677 first printing, facsimile edition (2000), sig. H, \"Of Baptism\"" ;
    gc:asPrinted "(f) Mar. 16.16; Act. 8.36,37" ;
    gc:resolutionNote "Note (f) read by the architect from the 1677 facsimile: Acts 8:36-37. The 1719 OCR reading \"37, 38\" is wrong." ;
    gc:status <vocab/status/proposed> ;
    gc:proposedBy <agent/build-agent> .

<argument/lbc-1689/29/3/001> a gc:Argument ;
    gc:source <source/lbc-1689/29/3> ;
    gc:supports <position/baptism-formula/triune-name> ;
    gc:cites <passage/kjv/Matt.28.19-Matt.28.20> ,
        <passage/kjv/Acts.8.38> ;
    gc:locator "29.3" ;
    gc:secondaryLocator "1677 first printing, facsimile edition (2000), sig. H, \"Of Baptism\"" ;
    gc:asPrinted "(g) Mat. 28. 19, 20. with Act. 8. 38." ;
    gc:status <vocab/status/proposed> ;
    gc:proposedBy <agent/build-agent> .

<argument/lbc-1689/29/4/001> a gc:Argument ;
    gc:source <source/lbc-1689/29/4> ;
    gc:supports <position/baptism-mode/immersion-only> ;
    gc:cites <passage/kjv/Matt.3.16> ,
        <passage/kjv/John.3.23> ;
    gc:locator "29.4" ;
    gc:secondaryLocator "1677 first printing, facsimile edition (2000), sig. H, \"Of Baptism\"" ;
    gc:asPrinted "(h) Mat. 3. 16. Joh. 3. 23." ;
    gc:status <vocab/status/proposed> ;
    gc:proposedBy <agent/build-agent> .

<argument/lbc-1689/29/2/002> a gc:Argument ;
    gc:source <source/lbc-1689/29/2> ;
    gc:supports <position/baptism-validity/subject-mode-formula> ;
    gc:cites <passage/kjv/Mark.16.16> ,
        <passage/kjv/Acts.8.36-Acts.8.37> ;
    gc:locator "29.2" ;
    gc:secondaryLocator "1677 first printing, facsimile edition (2000), sig. H, \"Of Baptism\"" ;
    gc:asPrinted "(f) Mar. 16.16; Act. 8.36,37" ;
    rdfs:comment "Note (f) again, as evidence for the subject element of the validity Position. This Argument is cited for the validity Position without an LBC Holding (ruling B-Q1 on report 12; M5)."@en ;
    gc:status <vocab/status/proposed> ;
    gc:proposedBy <agent/build-agent> .

<argument/lbc-1689/29/3/002> a gc:Argument ;
    gc:source <source/lbc-1689/29/3> ;
    gc:supports <position/baptism-validity/subject-mode-formula> ;
    gc:cites <passage/kjv/Matt.28.19-Matt.28.20> ,
        <passage/kjv/Acts.8.38> ;
    gc:locator "29.3" ;
    gc:secondaryLocator "1677 first printing, facsimile edition (2000), sig. H, \"Of Baptism\"" ;
    gc:asPrinted "(g) Mat. 28. 19, 20. with Act. 8. 38." ;
    rdfs:comment "Note (g) again, as evidence for the formula element of the validity Position. This Argument is cited for the validity Position without an LBC Holding (ruling B-Q1 on report 12; M5)."@en ;
    gc:status <vocab/status/proposed> ;
    gc:proposedBy <agent/build-agent> .

<argument/lbc-1689/29/4/002> a gc:Argument ;
    gc:source <source/lbc-1689/29/4> ;
    gc:supports <position/baptism-validity/subject-mode-formula> ;
    gc:cites <passage/kjv/Matt.3.16> ,
        <passage/kjv/John.3.23> ;
    gc:locator "29.4" ;
    gc:secondaryLocator "1677 first printing, facsimile edition (2000), sig. H, \"Of Baptism\"" ;
    gc:asPrinted "(h) Mat. 3. 16. Joh. 3. 23." ;
    rdfs:comment "Note (h) again, as evidence for the mode element of the validity Position. This Argument is cited for the validity Position without an LBC Holding (ruling B-Q1 on report 12; M5). Booth, Paedobaptism Examined (London, 1829) vol. 2, Part II, p. 280 note ‡, continued p. 281 (archive.org pdobaptismexamin02boot leaf 289), paraphrased: a ceremony essentially different from what Christ appointed is not baptism, so one who received it may afterwards be baptized without the charge of Anabaptism. Booth prints no Scripture there, so he enters as a note, not an Argument (M1)."@en ;
    gc:status <vocab/status/proposed> ;
    gc:proposedBy <agent/build-agent> .

<argument/lbc-1689/28/2/001> a gc:Argument ;
    gc:source <source/lbc-1689/28/2> ;
    gc:supports <position/baptism-validity/church-of-gospel-order> ;
    gc:cites <passage/kjv/Matt.28.19> ,
        <passage/kjv/1Cor.4.1> ;
    gc:locator "28.2" ;
    gc:secondaryLocator "1677 first printing, facsimile edition (2000), \"Of Baptism and the Lords Supper\"" ;
    gc:asPrinted "(b) Mat. 28. 19. 1 Cor. 4. 1." ;
    rdfs:comment "Note (b) of 28.2, as evidence for the administrator element of the validity Position (a church of gospel order). This Argument is cited for the validity Position without an LBC Holding (ruling B-Q1 on report 12; M5). No page is recorded for the secondary locator."@en ;
    gc:status <vocab/status/proposed> ;
    gc:proposedBy <agent/build-agent> .

