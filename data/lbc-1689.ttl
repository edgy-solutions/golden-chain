    gc:secondaryLocator "bible-researcher.com transcription" ;
    gc:secondaryLocator "IA bim_eighteenth-century_a-confession-of-faith-p_1719 (4th ed., 1719)" ;
    gc:asPrinted "Act. 8.36,37." ;
    gc:asPrinted "Acts 8. 37, 38." ;
    gc:resolutionNote "The transcription prints \"Act. 8.36,37.\"; the 1719 OCR reads \"Acts 8. 37, 38.\". Left to the architect's reading of the page image (ruling 6)." ;
    gc:status <vocab/status/proposed> ;
    gc:proposedBy <agent/build-agent> .

<argument/lbc-1689/29/3/001> a gc:Argument ;
