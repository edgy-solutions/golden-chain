<argument/lbc-1689/29/1/001> a gc:Argument ;
    gc:source <source/lbc-1689/29/1> ;
    gc:supports <position/baptism-significance/union-with-christ> ;
    gc:cites <passage/kjv/Rom.6.3-Rom.6.5> ,
