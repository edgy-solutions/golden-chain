        <passage/kjv/Gal.3.27> ,
        <passage/kjv/Mark.1.4> ,
        <passage/kjv/Rom.6.2> ,
        <passage/kjv/Rom.6.4> ;
    gc:citesCandidate <passage/kjv/Acts.2.41> ,
        <passage/kjv/Acts.8.12> ;
    gc:locator "29.1" ;
    gc:secondaryLocator "bible-researcher.com transcription" ;
    gc:secondaryLocator "IA bim_eighteenth-century_a-confession-of-faith-p_1719 (4th ed., 1719)" ;
    gc:asPrinted "Act. 26.16." ;
    gc:resolutionNote "Printed \"Act. 26.16.\" (transcription; the 1719 OCR agrees, unverified against the image). A known slip; the architect names Acts 2:41 or 8:12. The transcription notes that most modern editions read Acts 22:16. Neither candidate is picked (ruling 6)." ;
    gc:status <vocab/status/proposed> ;
    gc:proposedBy <agent/build-agent> .

<argument/lbc-1689/29/2/001> a gc:Argument ;
    gc:source <source/lbc-1689/29/2> ;
