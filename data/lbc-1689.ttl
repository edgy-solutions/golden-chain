# Second London Baptist Confession (docs/sources/lbc-1689.md). Reference only; no quotation.

<body/lbc-1689> a gc:Confession ;
    rdfs:label "Second London Baptist Confession (1677/1689)"@en ;
    gc:expressedIn <source/lbc-1689> .

<source/lbc-1689> a gc:SourceWork ;
    rdfs:label "A Confession of Faith (1677/1689), with proof texts"@en ;
    dcterms:bibliographicCitation "Witness: the 1677 first printing, facsimile edition (2000). Slug kept as lbc-1689 (architect ruling, 2026-10-25)." .

<source/lbc-1689/28/1> a gc:SourceDivision ;
    rdfs:label "LBC 28.1"@en ;
    dcterms:isPartOf <source/lbc-1689> .

<source/lbc-1689/29/1> a gc:SourceDivision ;
    rdfs:label "LBC 29.1"@en ;
    dcterms:isPartOf <source/lbc-1689> .

<source/lbc-1689/29/2> a gc:SourceDivision ;
    rdfs:label "LBC 29.2"@en ;
