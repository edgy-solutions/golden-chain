@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# Gill, Body of Divinity. PD text (docs/sources/gill-body-of-divinity.md). Cited by locator only;
# no quotation until OCR is verified (OCR HELD). Primary gc:locator is Gill's printed division;
# pages and asPrinted strings read from the BSB 2019 page images.

<body/gill> a gc:Systematic ;
    rdfs:label "John Gill, A Body of Doctrinal and Practical Divinity"@en ;
    gc:expressedIn <source/gill-body> .

<source/gill-body> a gc:SourceWork ;
    rdfs:label "John Gill, A Complete Body of Doctrinal and Practical Divinity (1769-70)"@en ;
    gc:paginationOf "BSB 2019 (ISBN 9781579780234), reproducing the 1839 London pagination" .

<source/gill-body/doctrinal/4/1> a gc:SourceDivision ;
    rdfs:label "Doctrinal Divinity, Book IV, Chap. I"@en ;
    dcterms:isPartOf <source/gill-body> .

<source/gill-body/doctrinal/4/5> a gc:SourceDivision ;
    rdfs:label "Doctrinal Divinity, Book IV, Chap. V: Of the Abrogation of the Old Covenant"@en ;
    dcterms:isPartOf <source/gill-body> .

<source/gill-body/practical/3/1> a gc:SourceDivision ;
    rdfs:label "Practical Divinity, Book III, Chap. I: Of Baptism"@en ;
    gc:pages "896-915" ;
    dcterms:isPartOf <source/gill-body> .

