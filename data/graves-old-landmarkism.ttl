# J. R. Graves, Old Landmarkism: What Is It? Reference only; no quotation.
# Graves is not a phase-1 Body, so there is no Body or Holding here; the Argument carries the evidence (PLAN_step3_minting Batch B).

<source/graves-old-landmarkism> a gc:SourceWork ;
    rdfs:label "J. R. Graves, Old Landmarkism: What Is It? (Memphis, 1880)"@en ;
    dcterms:bibliographicCitation "Memphis, 1880. Scan: archive.org oldlandmarkismw00gravgoog (leaf n = printed page + 6)." .

<source/graves-old-landmarkism/10> a gc:SourceDivision ;
    rdfs:label "Graves, ch. X"@en ;
    dcterms:isPartOf <source/graves-old-landmarkism> .

# ---------------------------------------------------------------- arguments

<argument/graves-old-landmarkism/10/001> a gc:Argument ;
    gc:source <source/graves-old-landmarkism/10> ;
    gc:supports <position/baptism-validity/church-of-our-order> ;
    gc:cites <passage/kjv/Matt.16.18> ,
        <passage/kjv/Heb.12.28> ,
        <passage/kjv/Dan.2.44> ;
    gc:locator "Ch. X" ;
    gc:secondaryLocator "IA oldlandmarkismw00gravgoog leaf 130" ,
        "Ch. VI, p. 64 (IA leaf 70)" ;
    gc:pages "124" ;
    gc:asPrinted "(Matt. 16: 18) … (Heb. 12: 28) … Daniel (2: 44)" ;
    rdfs:comment "Read as support for the administrator being a church of our own order, by identity or succession: the kingdom stood unbroken, and no unbaptized man may originate a church de novo. Graves disclaims proving each link of the succession (pp. 122-125)."@en ;
    gc:status <vocab/status/proposed> ;
    gc:proposedBy <agent/build-agent> .

# ---------------------------------------------------------------- passages cited here

<passage/kjv/Matt.16.18> a gc:Passage ;
    gc:versification "kjv" ; gc:book "Matt" ; gc:osisRef "Matt.16.18" ;
    gc:startOrdinal 546 ; gc:endOrdinal 546 .

<passage/kjv/Heb.12.28> a gc:Passage ;
    gc:versification "kjv" ; gc:book "Heb" ; gc:osisRef "Heb.12.28" ;
    gc:startOrdinal 277 ; gc:endOrdinal 277 .

<passage/kjv/Dan.2.44> a gc:Passage ;
    gc:versification "kjv" ; gc:book "Dan" ; gc:osisRef "Dan.2.44" ;
    gc:startOrdinal 65 ; gc:endOrdinal 65 .
